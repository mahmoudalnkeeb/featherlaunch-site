{
  "name": "FeatherLaunch",
  "short_name": "FeatherLaunch",
  "description": "A lightweight Minecraft launcher for older PCs",
  "start_url": "/",
  "display": "browser",
  "background_color": "#0e0f11",
  "theme_color": "#0e0f11",
  "icons": [
    {
      "src": "/assets/brand/web/favicon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/brand/web/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/brand/web/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
